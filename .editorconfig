root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.nix]
indent_size = 2

[*.md]
indent_size = 2

[{justfile,*.just}]
indent_size = 2

[manifest.yaml]
indent_size = 2

[{*.yml,*.yaml}]
indent_size = 2

[*.hcl]
indent_size = 2
